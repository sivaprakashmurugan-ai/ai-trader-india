
# --- DATABASE ---
POSTGRES_SERVER=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ai_trader
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:5432/${POSTGRES_DB}

# --- MARKET & SYMBOLS ---
TICKER_UNIVERSE=NIFTYBEES,BANKBEES,RELIANCE,HDFCBANK,TCS,INFY,SBIN,ICICIBANK,ITC,LT,HCLTECH,AXISBANK,KOTAKBANK,BAJFINANCE,ADANIENT,TITAN
INGEST_LOOP_SLEEP_SECONDS=300

# --- DATA INGESTION ---
BAR_INTERVAL_MINUTES=5
HISTORICAL_DAYS_TO_FETCH=90
INGEST_LOOP_SLEEP_SECONDS=300

# --- MODEL TRAINING ---
TRAIN_MAX_BARS=50000
TARGET_RETURN_THRESHOLD=0.003 # Predict if return > 0.3%
MODEL_TYPE=lightgbm

# --- TRADING AGENT ---
TRADE_START_TIME=09:15  # IST
TRADE_END_TIME=15:00    # IST
SQUARE_OFF_TIME=15:15   # IST
AGENT_LOOP_SLEEP_SECONDS=60

# --- RISK & POSITION SIZING ---
DAILY_BUDGET=100000.00
DAILY_MAX_LOSS_PCT=0.015
MAX_ACTIVE_POSITIONS=3
POSITION_ENTRY_PCT=0.25
MIN_TRADE_VALUE=5000.00
MAX_TRADE_VALUE_PER_SYMBOL=50000.00

# --- ENTRY/EXIT RULES ---
PROB_THRESHOLD_BUY=0.65
PROB_THRESHOLD_SELL=0.45
PROB_EMA_ALPHA=0.5
DOMINANCE_GAP=0.1
TAKE_PROFIT_PCT=0.012
STOP_LOSS_PCT=0.006
MIN_HOLD_MINUTES=10
COOLDOWN_MINUTES_AFTER_EXIT=15

# --- LIMITS & COSTS ---
MAX_TRADES_PER_DAY=25
MAX_TRADES_PER_SYMBOL_PER_DAY=5
